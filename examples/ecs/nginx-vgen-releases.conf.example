# VGen credential-free download site. This hostname never proxies Gateway API
# traffic and can later move unchanged to OSS/CDN.
server {
  listen 80;
  server_name vgen.zcbiz.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name vgen.zcbiz.com;

  ssl_certificate /etc/letsencrypt/live/vgen.zcbiz.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vgen.zcbiz.com/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  location = /releases/channels/stable.json {
    alias /var/www/vgen-releases/channels/stable.json;
    default_type application/json;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
  }

  location = /releases/install-macos.sh {
    alias /var/www/vgen-releases/install-macos.sh;
    default_type text/x-shellscript;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    add_header Content-Disposition 'attachment; filename="install-macos.sh"' always;
  }

  location = /releases/install-windows-worker.ps1 {
    alias /var/www/vgen-releases/install-windows-worker.ps1;
    default_type text/plain;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    add_header Content-Disposition 'attachment; filename="install-windows-worker.ps1"' always;
  }

  location ~ "^/releases/(?<vgen_release_version>[0-9]+(?:\.[0-9]+){2}(?:[-+][A-Za-z0-9][A-Za-z0-9.-]{0,63})?)/(?<vgen_release_file>[A-Za-z0-9][A-Za-z0-9._+-]{0,191})$" {
    alias /var/www/vgen-releases/$vgen_release_version/$vgen_release_file;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location /releases/ {
    return 404;
  }

  location / {
    return 404;
  }
}
