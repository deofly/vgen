# VGen v1 public TLS endpoint for the audited ECS host.
# The existing certificate paths are retained; only the upstream changes from
# the legacy Broker on 127.0.0.1:8000 to the v1 Gateway on 127.0.0.1:8010.
server {
  listen 80;
  server_name vgen.zcbiz.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name vgen.zcbiz.com;

  ssl_certificate /etc/letsencrypt/live/vgen.zcbiz.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vgen.zcbiz.com/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  # The first acceptance run uses Gateway-local ciphertext artifacts. Inputs
  # and generated videos therefore pass through Nginx; the old 10 MiB limit is
  # not sufficient. Application-side artifact limits still apply.
  client_max_body_size 5g;
  client_body_timeout 30m;
  send_timeout 30m;
  proxy_request_buffering off;
  proxy_buffering off;

  proxy_connect_timeout 10s;
  proxy_read_timeout 30m;
  proxy_send_timeout 30m;
  proxy_http_version 1.1;
  proxy_set_header Connection "";

  # Public installers contain no User, Device, Worker, Invite, or session
  # credentials. Root publishes reviewed files atomically into this directory;
  # the Gateway service and Nginx only need read access. A deployment backed by
  # OSS/CDN can replace these aliases while keeping the same public paths.
  # The mutable stable pointer must always be revalidated.
  location = /releases/channels/stable.json {
    alias /var/www/vgen-releases/channels/stable.json;
    default_type application/json;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
  }

  # This credential-free bootstrap is regenerated with the stable pointer. It
  # embeds the expected immutable manifest digest and fails closed while a
  # publication is between those two atomic file switches.
  location = /releases/install-macos.sh {
    alias /var/www/vgen-releases/install-macos.sh;
    default_type text/x-shellscript;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    add_header Content-Disposition 'attachment; filename="install-macos.sh"' always;
  }

  # Versioned release URLs are immutable. The constrained captures deliberately
  # exclude slashes, dot-segments, and encoded path traversal.
  location ~ "^/releases/(?<vgen_release_version>[0-9]+(?:\.[0-9]+){2}(?:[-+][A-Za-z0-9][A-Za-z0-9.-]{0,63})?)/(?<vgen_release_file>[A-Za-z0-9][A-Za-z0-9._+-]{0,191})$" {
    alias /var/www/vgen-releases/$vgen_release_version/$vgen_release_file;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # Do not let an unmatched release URL fall through to FastAPI or expose a
  # directory listing. Missing/empty release roots therefore return a plain 404.
  location /releases/ {
    return 404;
  }

  location / {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $request_id;
  }
}
