# VGen Gateway API-only TLS endpoint. Installer downloads deliberately use a
# separate hostname; see nginx-vgen-releases.conf.example.
server {
  listen 80;
  server_name vgen-gw.zcbiz.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name vgen-gw.zcbiz.com;

  ssl_certificate /etc/letsencrypt/live/vgen-gw.zcbiz.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vgen-gw.zcbiz.com/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  # Encrypted uploads use direct OSS tickets in production. Keep this limit for
  # control-plane requests and compatibility probes; application limits still apply.
  client_max_body_size 5g;
  client_body_timeout 30m;
  send_timeout 30m;
  proxy_request_buffering off;
  proxy_buffering off;

  proxy_connect_timeout 10s;
  proxy_read_timeout 30m;
  proxy_send_timeout 30m;
  proxy_http_version 1.1;
  proxy_set_header Connection "";

  location / {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $request_id;
  }
}
