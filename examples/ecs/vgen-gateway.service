[Unit]
Description=VGen v1 Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vgen
Group=vgen
WorkingDirectory=/opt/vgen-v1
EnvironmentFile=/etc/vgen-v1/gateway.env
ExecStart=/opt/vgen-v1/venv/bin/vgen-gateway \
  --database /var/lib/vgen-v1/vgen-gateway.db \
  serve \
  --host 127.0.0.1 \
  --port 8010 \
  --artifact-root /var/lib/vgen-v1/artifacts \
  --release-root /var/www/vgen-releases \
  --no-docs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vgen-v1
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
