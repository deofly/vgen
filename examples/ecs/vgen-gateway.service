[Unit]
Description=VGen Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vgen
Group=vgen
WorkingDirectory=/opt/vgen
EnvironmentFile=/etc/vgen/gateway.env
ExecStart=/opt/vgen/venv/bin/vgen-gateway \
  --database /var/lib/vgen/vgen-gateway.db \
  serve \
  --host 127.0.0.1 \
  --port 8010 \
  --artifact-root /var/lib/vgen/artifacts \
  --release-root /var/www/vgen-releases \
  --no-docs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vgen
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
