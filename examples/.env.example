# Copy this file to .env. Never commit the populated .env file.

# The Compose example is development-only and binds Gateway to loopback.
# Use examples/ecs/setup-gateway.sh for an Internet-facing deployment.
VGEN_GATEWAY_BIND_PORT=8000
VGEN_GATEWAY_DOCS=1

# Set this to the non-root numeric UID that owns the Worker credential files on
# Linux (`id -u` for that account). Matching it keeps the 0600 mount readable
# without running the Worker as root. Docker Desktop normally maps this for you.
VGEN_CONTAINER_UID=1000

# Required only for the worker profile. This URL is resolved inside
# the container. ComfyUI must remain local/private, never public Internet-facing.
VGEN_COMFYUI_URL=http://host.docker.internal:8188
VGEN_COMFYUI_OUTPUT_DIR_HOST=./comfy-output
VGEN_COMFYUI_MODEL_ROOT_HOST=./comfy-models
# Machine-admin reviewed graph policy; authenticated execution fails closed
# without it. The bundled MiniMax policy is a starting point, not blanket trust.
VGEN_COMFYUI_POLICY_FILE_HOST=./comfyui-minimax-h3-policy.yaml

# Worker principal and local credential directory. Generate credentials.json
# by the universal Windows installer; keep it private and outside
# Git. Confirm flags with `vgen-worker serve --help` for the current alpha.
VGEN_WORKER_ID=
VGEN_WORKER_CREDENTIALS_DIR=./worker-credentials
